# Supabase Configuration
# Replace these placeholder values with your Supabase Project Settings > API credentials
VITE_SUPABASE_URL= 
VITE_SUPABASE_ANON_KEY= 

# Canonical site origin. Password-reset emails must point here regardless of the
# host the form was submitted from -- Supabase silently ignores a redirect URL
# that is missing from its allowlist and falls back to the project Site URL,
# which mails the user a link that goes nowhere. This value must also be listed
# under Supabase > Authentication > URL Configuration > Redirect URLs.
# Leave blank to use the current origin (local dev).
VITE_SITE_URL=


# Place search Edge Function
VITE_PLACES_PROXY_URL=http://localhost:54321/functions/v1/places-autocomplete

# Task agent Edge Function (calls Gemini to parse natural-language task messages)
VITE_TASK_AGENT_URL=http://localhost:54321/functions/v1/task-agent
